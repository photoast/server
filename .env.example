MONGODB_URI=mongodb://localhost:27017/photoast
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# MongoDB 최대 스토리지 용량 (MB) - Atlas M0 무료 티어: 512MB
# M2: 2GB, M5: 5GB 등 사용 중인 플랜에 맞게 설정
MONGODB_MAX_STORAGE_MB=512

# Vercel Blob 스토리지 토큰 (https://vercel.com/docs/storage/vercel-blob)
# Vercel 대시보드 > Storage > Blob > .env.sample 참고
# 로컬 개발에서는 설정하지 않아도 public/uploads 폴더에 저장됩니다
BLOB_READ_WRITE_TOKEN=

# Vercel Blob 최대 스토리지 용량 (MB) - Hobby 무료 티어: 500MB
# Pro: 10GB, Enterprise: 맞춤 설정
VERCEL_BLOB_MAX_STORAGE_MB=500

# NicePay
NEXT_PUBLIC_NICEPAY_CLIENT_ID=S2_af4543a0be4d49a98122e01ec2059a56
NICEPAY_SECRET_KEY=

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Kakao OAuth (https://developers.kakao.com/console/app)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
