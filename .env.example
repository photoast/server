MONGODB_URI=mongodb://localhost:27017/photoast
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# MongoDB 최대 스토리지 용량 (MB) - Atlas M0 무료 티어: 512MB
# M2: 2GB, M5: 5GB 등 사용 중인 플랜에 맞게 설정
MONGODB_MAX_STORAGE_MB=512

# Vercel Blob 스토리지 토큰 (https://vercel.com/docs/storage/vercel-blob)
# Vercel 대시보드 > Storage > Blob > .env.sample 참고
# 로컬 개발에서는 설정하지 않아도 public/uploads 폴더에 저장됩니다
BLOB_READ_WRITE_TOKEN=

# Vercel Blob 최대 스토리지 용량 (MB) - Hobby 무료 티어: 500MB
# Pro: 10GB, Enterprise: 맞춤 설정
VERCEL_BLOB_MAX_STORAGE_MB=500

# NicePay
NEXT_PUBLIC_NICEPAY_CLIENT_ID=S2_af4543a0be4d49a98122e01ec2059a56
NICEPAY_SECRET_KEY=

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Kakao OAuth (https://developers.kakao.com/console/app)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────
# 영업 랜딩(/owner) CTA 폼 리드 알림 채널
# 설정된 채널로만 전송되며 여러 개를 동시에 켜둘 수 있습니다.
# 하나도 없으면 MongoDB에는 저장되지만 즉시 알림은 가지 않습니다.
# ─────────────────────────────────────────────────────────────
# 텔레그램: @BotFather 로 봇 생성 후 토큰 발급, @userinfobot 으로 chat_id 확인
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 슬랙: 워크스페이스 > Incoming Webhooks 에서 발급
SLACK_WEBHOOK_URL=
# 디스코드: 채널 설정 > 연동 > 웹후크 에서 발급
DISCORD_WEBHOOK_URL=
